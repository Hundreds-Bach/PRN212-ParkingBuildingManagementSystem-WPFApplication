## Ignore Visual Studio temporary files, build results, and
## user-specific files.

# User-specific files
*.rsuser
*.suo
*.user
*.user-servicing
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/ActiveState ActiveGo)
*.userprefs

# Mono auto generated files
*.t10t

# Nesting Profiles
*.nestingprofiles

# Visual Studio Code project settings
.vscode/

# Build results
[Dd]ebug/
[Dd]ebugPS/
[Rr]elease/
[Rr]eleasePS/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Log]/
[Ll]og/

# Visual Studio 2015/2017 cache directory
.vs/
# Visual Studio 2017 AutoGenerated files
Generated\ Files/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent.log

# JetBrains Rider
.idea/
*.sln.iml

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored as of NuGet 2.7.2+
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
# Uncomment if using NuGet Share and it has a native libraries directory
# !**/packages/build/native/
# Keep packages.config since it defines packages
!**/packages.config

# Tools
_ReSharper*/
*.[ReS]harper
*.DotSettings.user

# Publish Web output
*.[Pp]ublish.xml
*.azurePubxml
# Note: The "client" folder is a subfolder of VS 2015 publish profiles and contains profile metadata.
# client/

# Windows image analyses cache
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycler Folder
$RECYCLE.BIN/

# Log files
*.log
*.log.*

# Diagnostic crash logs
*.dmp

# Crash dumps
*.crash
