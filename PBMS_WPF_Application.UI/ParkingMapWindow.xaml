<Window x:Class="PBMS_WPF_Application.ParkingMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PBMS_WPF_Application"
        mc:Ignorable="d"
        Title="PBMS - Parking Map" 
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Simple Color triggers for the slot rectangles -->
        <Style x:Key="SlotCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="80"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Gray"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SlotStatus}" Value="available">
                    <Setter Property="Background" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="Available">
                    <Setter Property="Background" Value="Green"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="AVAILABLE">
                    <Setter Property="Background" Value="Green"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding SlotStatus}" Value="reserved">
                    <Setter Property="Background" Value="Yellow"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="Reserved">
                    <Setter Property="Background" Value="Yellow"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="RESERVED">
                    <Setter Property="Background" Value="Yellow"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding SlotStatus}" Value="occupied">
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="Occupied">
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="OCCUPIED">
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Simple TextBlock foreground color triggers -->
        <Style x:Key="SlotTextBlockStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SlotStatus}" Value="available">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="Available">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="AVAILABLE">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding SlotStatus}" Value="reserved">
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="Reserved">
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="RESERVED">
                    <Setter Property="Foreground" Value="Black"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding SlotStatus}" Value="occupied">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="Occupied">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding SlotStatus}" Value="OCCUPIED">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <!-- Left side: Title, Buttons -->
            <ColumnDefinition Width="180"/>
            <!-- Right side: Grid Map -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Controls Panel -->
        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,15,0">
            <!-- Header Title -->
            <TextBlock Text="Parking Map" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

            <!-- Selection Buttons -->
            <Button x:Name="btnBasement" Content="Basement 1" Height="30" FontWeight="Bold" Margin="0,0,0,10" Click="BtnBasement_Click"/>
            <Button x:Name="btnFloor1" Content="Floor 1" Height="30" Margin="0,0,0,20" Click="BtnFloor1_Click"/>

            <Separator Margin="0,0,0,20"/>

            <TextBlock x:Name="lblSelectedSlot" Text="O dang chon: chua co" TextWrapping="Wrap" Margin="0,0,0,10"/>

            <TextBlock Text="Bien so xe:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtLicensePlate" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

            <Button x:Name="btnCheckIn" Content="Check-in" Height="30" Margin="0,0,0,10" Click="BtnCheckIn_Click"/>
            <Button x:Name="btnCheckOut" Content="Check-out" Height="30" Margin="0,0,0,20" Click="BtnCheckOut_Click"/>

            <Separator Margin="0,0,0,20"/>

            <!-- Logout Button -->
            <Button x:Name="btnLogout" Content="Đăng Xuất" Height="30" Click="BtnLogout_Click"/>
        </StackPanel>

        <!-- Right Map Panel -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Current Floor Label -->
            <TextBlock x:Name="lblFloorHeader" Text="Đang hiển thị: Basement 1" FontSize="16" FontWeight="SemiBold" Margin="5,0,0,15" Grid.Row="0"/>

            <!-- Scrollable Grid -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ListBox x:Name="lstParkingSlots" BorderThickness="0" Background="Transparent" SelectionChanged="LstParkingSlots_SelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Width="880"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SlotCardStyle}">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Slot Name -->
                                        <RowDefinition Height="Auto"/> <!-- Type -->
                                        <RowDefinition Height="Auto"/> <!-- Status -->
                                    </Grid.RowDefinitions>

                                    <!-- Slot Name -->
                                    <TextBlock Grid.Row="0" Text="{Binding SlotName}" FontWeight="Bold" FontSize="12" Style="{StaticResource SlotTextBlockStyle}"/>

                                    <!-- Type -->
                                    <TextBlock Grid.Row="1" FontSize="11" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SlotTextBlockStyle}">
                                                <Setter Property="Text" Value="Unknown"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TypeId}" Value="2">
                                                        <Setter Property="Text" Value="Car"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TypeId}" Value="1">
                                                        <Setter Property="Text" Value="Motorbike"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Status -->
                                    <TextBlock Grid.Row="2" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SlotTextBlockStyle}">
                                                <Setter Property="Text" Value=""/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="available">
                                                        <Setter Property="Text" Value="Available"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="Available">
                                                        <Setter Property="Text" Value="Available"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="AVAILABLE">
                                                        <Setter Property="Text" Value="Available"/>
                                                    </DataTrigger>
                                                    
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="reserved">
                                                        <Setter Property="Text" Value="Reserved"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="Reserved">
                                                        <Setter Property="Text" Value="Reserved"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="RESERVED">
                                                        <Setter Property="Text" Value="Reserved"/>
                                                    </DataTrigger>
                                                    
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="occupied">
                                                        <Setter Property="Text" Value="Occupied"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="Occupied">
                                                        <Setter Property="Text" Value="Occupied"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SlotStatus}" Value="OCCUPIED">
                                                        <Setter Property="Text" Value="Occupied"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
