<Window x:Class="PBMS_WPF_Application.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PBMS - Admin Dashboard" 
        Height="700" Width="1180"
        WindowStartupLocation="CenterScreen">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="QUẢN TRỊ HỆ THỐNG" FontSize="22" FontWeight="Bold"/>
            <Button Content="Làm mới" Margin="20,0,8,0" Padding="14,6" Click="BtnRefresh_Click"/>
            <Button Content="Đăng xuất" Padding="14,6" Click="BtnLogout_Click"/>
        </StackPanel>
        <TabControl>
        <TabItem Header="Người dùng">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <!-- Left side: Create User Form -->
            <ColumnDefinition Width="320"/>
            <!-- Right side: Users DataGrid -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Registration Form -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="QUẢN TRỊ VIÊN" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="15" CornerRadius="5" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Tạo Người Dùng Mới" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <!-- Inputs -->
                    <TextBlock Text="Tên tài khoản (Username):" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtUsername" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Email:" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtEmail" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Số điện thoại:" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtPhone" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Mật khẩu:" Margin="0,0,0,5"/>
                    <PasswordBox x:Name="pbPassword" Height="28" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                    <TextBlock Text="Vai trò (Role):" Margin="0,0,0,5"/>
                    <ComboBox x:Name="cbRoles" Height="28" Margin="0,0,0,15" SelectedIndex="0">
                        <!-- We will populate this dynamically in code-behind -->
                    </ComboBox>

                    <!-- Submit Button -->
                    <Button x:Name="btnCreateUser" Content="TẠO NGƯỜI DÙNG" Height="35" Background="DarkGreen" Foreground="White" FontWeight="Bold" Click="BtnCreateUser_Click"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- Right Column: Users List -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Danh Sách Tài Khoản Hệ Thống" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            
            <DataGrid x:Name="dgUsers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F0F0F0" BorderThickness="1" BorderBrush="#DDDDDD">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="50"/>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                    <DataGridTextColumn Header="Số Điện Thoại" Binding="{Binding PhoneNumber}" Width="130"/>
                    <DataGridTextColumn Header="Vai Trò (Role)" Binding="{Binding Role.RoleName}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
        </TabItem>
        <TabItem Header="Tầng">
            <Grid Margin="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DataGrid x:Name="dgFloors" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgFloors_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding FloorId}" Width="70"/>
                        <DataGridTextColumn Header="Tên tầng" Binding="{Binding FloorName}" Width="*"/>
                        <DataGridTextColumn Header="Sức chứa" Binding="{Binding Capacity}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="Tên tầng"/><TextBox x:Name="txtFloorName" Margin="0,5,0,12"/>
                    <TextBlock Text="Sức chứa"/><TextBox x:Name="txtCapacity" Margin="0,5,0,12"/>
                    <WrapPanel>
                        <Button Content="Thêm mới" Padding="14,7" Margin="0,0,8,0" Click="BtnNewFloor_Click"/>
                        <Button Content="Lưu" Padding="14,7" Click="BtnSaveFloor_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Slot">
            <Grid Margin="10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <DataGrid x:Name="dgSlots" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgSlots_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding SlotId}" Width="55"/>
                        <DataGridTextColumn Header="Tên" Binding="{Binding SlotName}" Width="100"/>
                        <DataGridTextColumn Header="Tầng" Binding="{Binding Floor.FloorName}" Width="*"/>
                        <DataGridTextColumn Header="Loại xe" Binding="{Binding Type.TypeName}" Width="100"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding SlotStatus}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Đã xóa" Binding="{Binding IsDeleted}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="Tên slot"/><TextBox x:Name="txtSlotName" Margin="0,4,0,9"/>
                    <TextBlock Text="Tầng"/><ComboBox x:Name="cboFloors" DisplayMemberPath="FloorName" SelectedValuePath="FloorId" Margin="0,4,0,9"/>
                    <TextBlock Text="Loại xe"/><ComboBox x:Name="cboTypes" DisplayMemberPath="TypeName" SelectedValuePath="TypeId" Margin="0,4,0,9"/>
                    <TextBlock Text="Trạng thái"/><ComboBox x:Name="cboStatus" Margin="0,4,0,12"><ComboBoxItem Content="available"/><ComboBoxItem Content="reserved"/><ComboBoxItem Content="occupied"/></ComboBox>
                    <WrapPanel>
                        <Button Content="Thêm mới" Padding="12,7" Margin="0,0,7,0" Click="BtnNewSlot_Click"/>
                        <Button Content="Lưu" Padding="12,7" Margin="0,0,7,0" Click="BtnSaveSlot_Click"/>
                        <Button Content="Xóa/Khôi phục" Padding="12,7" Click="BtnToggleSlot_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Giá">
            <Grid Margin="10">
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid x:Name="dgPrices" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="DgPrices_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding TypeId}" Width="80"/>
                        <DataGridTextColumn Header="Loại xe" Binding="{Binding TypeName}" Width="*"/>
                        <DataGridTextColumn Header="Giá" Binding="{Binding Price, StringFormat=N0}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Giá mới:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtPrice" Width="180" Margin="8,0"/>
                    <Button Content="Cập nhật giá" Padding="13,6" Click="BtnUpdatePrice_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
        </TabControl>
    </DockPanel>
</Window>
