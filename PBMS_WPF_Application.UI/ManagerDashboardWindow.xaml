<Window x:Class="PBMS_WPF_Application.ManagerDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PBMS - Báo cáo &amp; thống kê" Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="BÁO CÁO &amp; THỐNG KÊ" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Làm mới" Margin="20,0,8,0" Padding="16,7" Click="BtnRefresh_Click"/>
            <Button Content="Đăng xuất" Padding="16,7" Click="BtnLogout_Click"/>
        </StackPanel>

        <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,18">
            <Border Background="#E3F2FD" Padding="14" Margin="4"><StackPanel><TextBlock Text="Tổng slot"/><TextBlock x:Name="txtTotalSlots" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#E8F5E9" Padding="14" Margin="4"><StackPanel><TextBlock Text="Slot trống"/><TextBlock x:Name="txtAvailable" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#FFF8E1" Padding="14" Margin="4"><StackPanel><TextBlock Text="Đã đặt"/><TextBlock x:Name="txtReserved" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#FFEBEE" Padding="14" Margin="4"><StackPanel><TextBlock Text="Đang sử dụng"/><TextBlock x:Name="txtOccupied" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#F3E5F5" Padding="14" Margin="4"><StackPanel><TextBlock Text="Người dùng"/><TextBlock x:Name="txtUsers" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#E0F7FA" Padding="14" Margin="4"><StackPanel><TextBlock Text="Phiên hoạt động"/><TextBlock x:Name="txtActive" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#ECEFF1" Padding="14" Margin="4"><StackPanel><TextBlock Text="Phiên hoàn thành"/><TextBlock x:Name="txtCompleted" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
            <Border Background="#E8F5E9" Padding="14" Margin="4"><StackPanel><TextBlock Text="Tổng doanh thu"/><TextBlock x:Name="txtRevenue" FontSize="25" FontWeight="Bold"/></StackPanel></Border>
        </UniformGrid>

        <GroupBox Header="Lịch sử gửi xe">
            <DataGrid x:Name="dgHistory" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã" Binding="{Binding SessionId}" Width="60"/>
                    <DataGridTextColumn Header="Người dùng" Binding="{Binding Username}" Width="130"/>
                    <DataGridTextColumn Header="Biển số" Binding="{Binding LicenseVehicle}" Width="110"/>
                    <DataGridTextColumn Header="Tầng" Binding="{Binding FloorName}" Width="110"/>
                    <DataGridTextColumn Header="Slot" Binding="{Binding SlotName}" Width="90"/>
                    <DataGridTextColumn Header="Check-in" Binding="{Binding CheckInTime, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                    <DataGridTextColumn Header="Check-out" Binding="{Binding CheckOutTime, StringFormat=dd/MM/yyyy HH:mm}" Width="145"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding SessionStatus}" Width="110"/>
                    <DataGridTextColumn Header="Số tiền" Binding="{Binding TotalAmount, StringFormat=N0}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DockPanel>
</Window>
