<Window x:Class="PBMS_WPF_Application.StaffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PBMS - Staff Dashboard" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <!-- Left side: Check-in/out Form -->
            <ColumnDefinition Width="300"/>
            <!-- Right side: Sessions DataGrid -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Operations -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="NHÂN VIÊN QUẦY" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="15" CornerRadius="5" Background="#F9F9F9">
                <StackPanel>
                    <TextBlock Text="Xác Nhận Xe Vào / Ra" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <!-- Inputs -->
                    <TextBlock Text="Mã vé (Ticket Code):" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtTicketCode" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                    <TextBlock Text="Biển số xe (License Plate):" Margin="0,0,0,5"/>
                    <TextBox x:Name="txtLicensePlate" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                    <!-- Buttons -->
                    <Button x:Name="btnConfirmCheckIn" Content="XÁC NHẬN CHECK-IN" Height="35" Background="DarkGreen" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Click="BtnConfirmCheckIn_Click"/>
                    <Button x:Name="btnConfirmCheckOut" Content="XÁC NHẬN CHECK-OUT" Height="35" Background="DarkBlue" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Click="BtnConfirmCheckOut_Click"/>
                </StackPanel>
            </Border>

            <!-- Bottom logout -->
            <Button x:Name="btnLogout" Content="Đăng Xuất" Height="30" Margin="0,30,0,0" Click="BtnLogout_Click"/>
        </StackPanel>

        <!-- Right Column: Parking Sessions List -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Danh Sách Phiên Đỗ Xe Đang Hoạt Động (Reserved / InUse)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            
            <DataGrid x:Name="dgSessions" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F0F0F0" BorderThickness="1" BorderBrush="#DDDDDD">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Vé" Binding="{Binding Ticket.TicketCode}" Width="100"/>
                    <DataGridTextColumn Header="Biển Số Xe" Binding="{Binding LicenseVehicle}" Width="110"/>
                    <DataGridTextColumn Header="Vị Trí Ô" Binding="{Binding Slot.SlotName}" Width="80"/>
                    <DataGridTextColumn Header="Loại Xe" Binding="{Binding Type.TypeName}" Width="90"/>
                    <DataGridTextColumn Header="Thời Gian Đặt" Binding="{Binding BookingTime, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="130"/>
                    <DataGridTextColumn Header="Thời Gian Vào" Binding="{Binding CheckInTime, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="130"/>
                    <DataGridTextColumn Header="Trạng Thái" Binding="{Binding SessionStatus}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
